# ==============================================================================
# Google Cloud Workshop Environment Configuration (CloudCorp AskHR Lab)
# Replace with your GCP project details:
# ==============================================================================

# Your active Google Cloud Project ID
PROJECT_ID=your-gcp-project-id

# Low-cost GCP Region
REGION=us-central1

# Google Cloud Storage bucket for policy document corpus
BUCKET_NAME=your-gcp-project-id-cloudcorp-policies

# Vertex AI Model Names
EMBEDDING_MODEL=text-embedding-004
GENERATIVE_MODEL=gemini-3.5-flash-lite

# Optional: Local Service Account JSON key (for running locally on laptop without gcloud)
# Leave blank if running in Google Colab (Colab uses OAuth via auth.authenticate_user())
GOOGLE_APPLICATION_CREDENTIALS=

# Service URLs (populated automatically or manually after Cloud Run/Functions deployment)
RAG_SERVICE_URL=
TICKET_TOOL_URL=

